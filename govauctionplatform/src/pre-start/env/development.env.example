## Environment ##
NODE_ENV=development

## Server ##
PORT=8891
HOST=0.0.0.0

## Logging (jet-logger) ##
JET_LOGGER_MODE=FILE
JET_LOGGER_FILEPATH=jet-logger.log
JET_LOGGER_TIMESTAMP=TRUE
JET_LOGGER_FORMAT=LINE

## Keycloak ##
# Base URL of your Keycloak instance
KEYCLOAK_URL=http://localhost:8080
# Realm name (default: auctions)
KEYCLOAK_REALM=auctions
# Resource-server client — used for audience validation in deserializeUser
KEYCLOAK_CLIENT_ID=auction-platform-api
# Public PKCE client — used in BFF code exchange and token refresh
KEYCLOAK_FRONTEND_CLIENT_ID=auction-platform-frontend
# M2M admin client — used for Keycloak Admin API calls (create/delete users)
KEYCLOAK_ADMIN_CLIENT_ID=auction-platform-admin
# Admin client secret — Clients → auction-platform-admin → Credentials tab
KEYCLOAK_ADMIN_CLIENT_SECRET=

## Session ##
EXPRESS_SESSION_SECRET=

## MongoDB ##
# Only needed when using Atlas (mongoDBURI is hardcoded to localhost in globals.ts)
MONGO_DB_USER=
MONGO_DB_PASS=

## Redis ##
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave blank if your Redis instance has no password
REDIS_PASS=

## Sealed bid encryption ##
# AES-256-GCM key — must be a 64-character hex string
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEALED_BID_ENCRYPTION_KEY=

## PayGate ##
PAYGATE_ID=
PAYGATE_ENCRYPTION_KEY=
## PayHost encryption key for refund processing (SingleFollowUpRequest → RefundRequest).
## Generate via MAP → Administration → Product Configuration → PayHost → Configure.
PAYHOST_ENCRYPTION_KEY=
## SERVER_BASE_URI is used for both NOTIFY_URL and RETURN_URL sent to PayGate.
## Must be a publicly reachable URL (ngrok tunnel for local dev).
SERVER_BASE_URI=

## Elasticsearch ##
ELASTICSEARCH_NODE=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

## Firebase ##
# Service account JSON as a single-line string
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Flatten to one line: node -e "const c=require('./sa.json'); console.log(JSON.stringify(c))"
FIREBASE_SERVICE_ACCOUNT_CREDENTIALS=

## External APIs ##
BAITS_API_TOKEN=
ID_VERIFICATION_API_KEY=
